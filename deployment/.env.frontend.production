# Production .env for Frontend (RISE-Frontend)
# ---------------------------------------------
# Create on VM at: /var/www/rise/public_html/RISE-Frontend/.env

# The frontend needs to know where the backend API is
BACKEND_URL=https://rise.altzor.com/api

# Flask secret key for sessions
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS

DEBUG=False
