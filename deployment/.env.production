# Production .env for rise.altzor.com
# -------------------------------------
# Create this file on the VM at: /var/www/rise/public_html/HRMS/.env
# via SSH:  nano /var/www/rise/public_html/HRMS/.env
# IMPORTANT: Do NOT commit this file to Git. Keep it secure on the server only.

# Database Configuration (VM's local MySQL)
DB_HOST=localhost
DB_NAME=hrms
DB_USER=hrms_user
DB_PASS=CHANGE_THIS_TO_STRONG_PASSWORD

# Security — CHANGE THIS to a long random string before deploying
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS

# App Configuration
PORT=8000
DEBUG=False
UPLOAD_FOLDER=/var/www/rise/public_html/HRMS/uploads

# Production URL
FRONTEND_URL=https://rise.altzor.com

# Email / SMTP Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=shruti.jadhavjs@gmail.com
MAIL_PASSWORD=jzgwwhlmzsejvfkw
MAIL_DEFAULT_SENDER=HRMS Notifications <shruti.jadhavjs@gmail.com>
