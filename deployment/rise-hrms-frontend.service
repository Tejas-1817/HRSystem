[Unit]
Description=Gunicorn instance for RISE HRMS Frontend
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/rise/public_html/HRMS/RISE-Frontend
Environment="PATH=/var/www/rise/public_html/HRMS/RISE-Frontend/venv/bin"
EnvironmentFile=/var/www/rise/public_html/HRMS/RISE-Frontend/.env
ExecStart=/var/www/rise/public_html/HRMS/RISE-Frontend/venv/bin/gunicorn \
          --workers 3 \
          --bind 127.0.0.1:8001 \
          --timeout 120 \
          --access-logfile /var/log/rise-hrms-frontend-access.log \
          --error-logfile /var/log/rise-hrms-frontend-error.log \
          run:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
